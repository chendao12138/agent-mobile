{
  "name": "cli-mobile",
  "version": "0.1.0",
  "description": "Mobile remote control for Claude Code CLI",
  "type": "module",
  "bin": {
    "cli-mobile": "./bin/cli-mobile.mjs"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "dev:ui": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run -c vitest.config.browser.ts",
    "test:all": "vitest run && vitest run -c vitest.config.browser.ts"
  },
  "dependencies": {
    "express": "^4.21.0",
    "jsqr": "^1.4.0",
    "multer": "^2.2.0",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
