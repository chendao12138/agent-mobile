# frp 客户端配置（部署在你的 Mac 上）
# frp 项目: https://github.com/fatedier/frp

serverAddr = "your-vps-ip-or-domain.com"
serverPort = 7000

[auth]
method = "token"
token = "CHANGE_ME_TO_RANDOM_STRING_64_CHARS"

# CLI Mobile STCP 代理
[[proxies]]
name = "cli-mobile-stcp"
type = "stcp"
secretKey = "CHANGE_ME_TO_RANDOM_32_CHARS"
localIP = "127.0.0.1"
localPort = 3009
